// The built-in 5x7 pixel font (cell 6x9: rows 1-7 for capitals and ascenders, row 0 for umlaut dots, row 8 for
// descenders) so that text works without font files. Glyphs are written as rows of five characters ('#' = pixel).

namespace Amber.Player.Graphics;

using System;
using Amber.Base;
using Amber.Graphics;

const int CellWidth = 6;
const int CellHeight = 9;
const int LineHeight = 10;

/// The table BuildGlyphs fills (declared first: globals are initialized in order).
Dictionary<int, uint8[]> GlyphTable = Dictionary<int, uint8[]>.Create();

/// The glyphs by code point: 9 rows of 5 pixels (1 = set).
Dictionary<int, uint8[]> Glyphs = BuildGlyphs();

/// The characters the text renderer draws (C#: TextRenderer's alphabet); others are drawn as '?', spaces not at all.
string FontAlphabet = " !\"#%'()*+,-./0123456789:;<=>?ABCDEFGHIJKLMNOPQRSTUVWXYZ[]_abcdefghijklmnopqrstuvwxyzäöüÄÖÜß";

/// The pixels of the glyph of a code point, or the ones of '?' for a character without a glyph.
uint8[] GlyphOf(int codePoint)
{
	if (Glyphs.TryGet(codePoint) is uint8[] glyph)
		return glyph;

	return Glyphs.GetOrDefault(63, new uint8[45]);
}

void AddGlyph(int codePoint, string[] rows)
{
	var pixels = new uint8[45];

	for (var y = 0; y < 9; y += 1)
	{
		for (var x = 0; x < 5; x += 1)
		{
			if (rows[y][x] == '#')
				pixels[y * 5 + x] = 1;
		}
	}

	GlyphTable.Set(codePoint, pixels);
}

// rows are given for row indices 1..7 (seven rows); top is row 0, bottom row 8
void Glyph(int codePoint, string body, string top, string bottom)
{
	var rows = body.Split("/");

	AddGlyph(codePoint, new string[] { top, rows[0].ToString(), rows[1].ToString(), rows[2].ToString(), rows[3].ToString(), rows[4].ToString(), rows[5].ToString(), rows[6].ToString(), bottom });
}

// x-height letters are given as rows 3..7; top = row 1 (umlaut dots), upper = row 2, bottom = row 8
void GlyphLow(int codePoint, string rows3To7, string top, string upper, string bottom)
{
	var rows = rows3To7.Split("/");

	AddGlyph(codePoint, new string[] { ".....", top, upper, rows[0].ToString(), rows[1].ToString(), rows[2].ToString(), rows[3].ToString(), rows[4].ToString(), bottom });
}

