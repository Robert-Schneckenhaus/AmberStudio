// Generates the C header with the constants and name tables of the script format (include/amber_tables.h of the C
// runtime) from the opcode tables, so that CShift and C never disagree (task 6.2/6.3).

namespace Amber.Cook.CTables;

using System;
using Amber.Base;
using Amber.Script.Common;

string Generate()
{
	var text = StringBuilder.Create();

	text.AppendLine("/* Generated by \"amberc gen-c\" from the opcode tables of the C# compiler. Do not edit. */");
	text.AppendLine("#ifndef AMBER_TABLES_H");
	text.AppendLine("#define AMBER_TABLES_H");
	text.AppendLine();
	text.AppendLine("#include <string.h>");
	text.AppendLine();

	AppendConstants(text, TriggerTypeNames, "AMB_TRIG_");
	AppendConstants(text, TriggerScopeNames, "AMB_SCOPE_");
	AppendConstants(text, ConditionOpNames, "AMB_COND_");
	AppendConstants(text, ActionOpNames, "AMB_ACT_");
	AppendConstants(text, StateNamespaceNames, "AMB_NS_");
	AppendConstants(text, GroupModeNames, "AMB_MODE_");
	AppendConstants(text, ComparisonNames, "AMB_CMP_");
	AppendConstants(text, SymbolKindNames, "AMB_SYM_");

	var triggers = List<NameEntry>.Create();

	foreach (var info in TriggerTable.All)
		triggers.Add(NameEntry { Id = (int)info.Type, Name = info.Name, Blocking = false });

	var actions = List<NameEntry>.Create();

	foreach (var info in ActionTable.All)
		actions.Add(NameEntry { Id = (int)info.Op, Name = info.Name, Blocking = info.Blocking });

	var conditions = List<NameEntry>.Create();

	foreach (var info in ConditionTable.All)
		conditions.Add(NameEntry { Id = (int)info.Op, Name = info.Name, Blocking = false });

	AppendNames(text, "amb_trigger", triggers);
	AppendNames(text, "amb_action", actions);
	AppendNames(text, "amb_condition", conditions);

	text.AppendLine("/* the kind of a symbol prefix (\"I\" for items ...), -1 if unknown */");
	text.AppendLine("static inline int amb_symbol_kind(const char *prefix)");
	text.AppendLine("{");

	foreach (var pair in SymbolKinds.Prefixes)
		text.AppendLine("\tif (strcmp(prefix, \"" + pair.Prefix + "\") == 0) return " + (int)pair.Kind + ";");

	text.AppendLine("\treturn -1;");
	text.AppendLine("}");
	text.AppendLine();
	text.AppendLine("#endif");

	return text.ToString();
}

struct NameEntry
{
	int Id;
	string Name;
	bool Blocking;
}

int CompareEnumEntries(EnumEntry a, EnumEntry b)
{
	return CompareInt(a.Value, b.Value);
}

/// The members in the order of Enum.GetValues (by value).
void AppendConstants(StringBuilder text, EnumEntry[] members, string prefix)
{
	foreach (var member in SortArray(members, CompareEnumEntries))
		text.AppendLine("#define " + prefix + Snake(member.Name) + " 0x" + Hex(member.Value, 2));

	text.AppendLine();
}

/// name(id), id_by_name(name) and, for actions, blocking(id).
void AppendNames(StringBuilder text, string prefix, List<NameEntry> list)
{
	text.AppendLine("static inline const char *" + prefix + "_name(unsigned id)");
	text.AppendLine("{");
	text.AppendLine("\tswitch (id)");
	text.AppendLine("\t{");

	foreach (var entry in list)
		text.AppendLine("\t\tcase 0x" + Hex(entry.Id, 2) + ": return \"" + entry.Name + "\";");

	text.AppendLine("\t\tdefault: return \"?\";");
	text.AppendLine("\t}");
	text.AppendLine("}");
	text.AppendLine();
	text.AppendLine("/* the ID of a name of the source language, -1 if unknown */");
	text.AppendLine("static inline int " + prefix + "_by_name(const char *name)");
	text.AppendLine("{");

	foreach (var entry in list)
		text.AppendLine("\tif (strcmp(name, \"" + entry.Name + "\") == 0) return 0x" + Hex(entry.Id, 2) + ";");

	text.AppendLine("\treturn -1;");
	text.AppendLine("}");
	text.AppendLine();

	if (prefix == "amb_action")
	{
		text.AppendLine("/* true if the action can suspend the thread */");
		text.AppendLine("static inline int amb_action_blocking(unsigned id)");
		text.AppendLine("{");
		text.AppendLine("\tswitch (id)");
		text.AppendLine("\t{");

		foreach (var entry in list)
		{
			if (entry.Blocking)
				text.AppendLine("\t\tcase 0x" + Hex(entry.Id, 2) + ":");
		}

		text.AppendLine("\t\t\treturn 1;");
		text.AppendLine("\t\tdefault:");
		text.AppendLine("\t\t\treturn 0;");
		text.AppendLine("\t}");
		text.AppendLine("}");
		text.AppendLine();
	}
}

/// PascalCase to UPPER_SNAKE_CASE: EnterTile becomes ENTER_TILE, SetVar32 becomes SET_VAR32.
string Snake(string name)
{
	var result = StringBuilder.Create();

	for (var i = 0; i < name.Length; i += 1)
	{
		if (i > 0 && Char.IsUpper(name[i]) && (Char.IsLower(name[i - 1]) || Char.IsDigit(name[i - 1])))
			result.Append('_');

		result.Append(Char.ToUpper(name[i]));
	}

	return result.ToString();
}
