/// The code points the renderer has glyphs for (see FontAlphabet).
Dictionary<int, bool> DrawableCharacters = BuildDrawable();

Dictionary<int, bool> BuildDrawable()
{
	var result = Dictionary<int, bool>.Create();
	int offset = 0;

	while (offset < FontAlphabet.Length)
	{
		var point = DecodeUtf8(FontAlphabet, offset);

		result.Set(point.Value, true);
		offset += point.Length;
	}

	return result;
}
